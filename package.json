{
  "name": "mcp-cassette",
  "version": "0.2.0",
  "description": "Record a real MCP session once — replay it forever. VCR-style record/replay, contract snapshots, and safety checks for Model Context Protocol servers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "mock",
    "record",
    "replay",
    "cassette",
    "contract-testing",
    "ci"
  ],
  "license": "Apache-2.0",
  "author": "Hoang Le <ivermin1123@gmail.com>",
  "homepage": "https://mcpcassette.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivermin1123/mcp-cassette.git"
  },
  "bugs": {
    "url": "https://github.com/ivermin1123/mcp-cassette/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-cassette": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "4.9.0",
    "recheck": "^4.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
